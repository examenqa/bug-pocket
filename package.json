{
  "name": "bug-pocket",
  "version": "0.1.0",
  "description": "Windows-first quick bug capture desktop app for QA testers.",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build && node scripts/fix-preload.js",
    "start": "electron-vite build && node scripts/fix-preload.js && electron .",
    "dist": "electron-vite build && node scripts/fix-preload.js && electron-builder"
  },
  "build": {
    "appId": "com.bugpocket.app",
    "productName": "Bug Pocket",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": true,
    "directories": {
      "output": "release-build",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bug-pocket-icon.png",
        "to": "bug-pocket-icon.png"
      },
      {
        "from": "resources/bug-pocket-title.png",
        "to": "bug-pocket-title.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "perMachine": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "afterPack": "scripts/patch-windows-icon.cjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.10.0",
    "extract-zip": "^2.0.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "30.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
